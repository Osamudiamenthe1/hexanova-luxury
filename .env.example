# =============================================================================
# Deval Luxury - environment variables
# =============================================================================
# Copy this file to ".env.local" and fill in the real values:
#
#     cp .env.example .env.local
#
# ".env.local" is git-ignored and must NEVER be committed.
# Set the same variables in the Vercel dashboard before you deploy.
# =============================================================================


# --- Supabase -----------------------------------------------------------------
# Found in Supabase: Project Settings -> API.
# The URL looks like https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" key. It is SAFE to expose to the browser because
# Row Level Security is what actually protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DO NOT ADD A SERVICE ROLE KEY HERE.
# A service-role key bypasses Row Level Security completely. This project is
# designed so it is never needed. If you are ever tempted to add one, ask first.


# --- Site ---------------------------------------------------------------------
# Used for absolute URLs in metadata, Open Graph tags, and the sitemap.
# Local:  http://localhost:3000
# Live:   https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Enquiry notification emails (Resend) - used from Phase 5 -----------------
# Get this from https://resend.com/api-keys
RESEND_API_KEY=

# Where "you have a new enquiry" emails should be delivered.
# Can be a comma-separated list, e.g. hello@deval.com,sales@deval.com
ENQUIRY_NOTIFY_EMAIL=

# The verified "from" address in Resend, e.g. "Deval Luxury <enquiries@deval.com>".
# While testing you can use "onboarding@resend.dev".
ENQUIRY_FROM_EMAIL=